# Lokaal: kopieer naar .env.local. pnpm dev schakelt de lokale repetitielogin
# expliciet in; die werkt uitsluitend in development op loopback, zonder proxy
# of remote Supabase/databaseconfiguratie. Geen accounts nodig voor ?demo=1.
APP_URL=http://127.0.0.1:4173
MILO_LOCAL_AUTH=false
SQLITE_PATH=.data/milobingo.sqlite
OBJECT_STORAGE_PATH=.data/objects

# Supabase: per omgeving invullen voor echte Auth + PostgreSQL.
# Laat leeg voor lokaal/offline. Alle waarden worden server-side gelezen.
SUPABASE_URL=
# Publieke CA als base64-PEM voor Supabase PostgreSQL-TLS; geen private key.
SUPABASE_DB_CA_BASE64=
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=

# Optioneel: zet op milo-private om remote private objecten expliciet te kiezen.
# Leeg laten voor lokale opslag; vereist bij activatie URL + secret + DATABASE_URL.
# Nooit de secret key naar de browser doorgeven.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=

# Optioneel voor de lokale demo; verplicht voor beveiligde regie-/mailstudio-
# instellingen en versleutelde frozen mailpayloads: 64 willekeurige hextekens.
# Behoud bij data-import de oorspronkelijke sleutel. Geen sleutel meegeleverd.
VLAMPIE_SETTINGS_KEY=

# Voorkeur: OpenAI instellen in Instellingen → OpenAI in de regie.
# Optionele bestaande serverfallback; een bewuste regie-instelling gaat voor.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts

# Optionele niet-geheime release-identiteit; later door de echte wrapper invullen.
RELEASE_SHA=
RELEASE_ID=
CONFIG_VERSION=

# Voorkeur: LiveKit instellen in Instellingen → E-mail & bellen in de regie.
# Optionele serverfallback: vul hiervoor alle drie in. Regie-instellingen gaan voor.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Resend-sleutel, afzender en verzendmodus beheer je in de app; geen env-key nodig.
# Nieuwe instellingen starten met verzending uit. Staging vereist testontvangers.
# De beschermde deploybroker legt deze omgevingsgrens zelf vast.
MAIL_ENVIRONMENT=staging
# Optionele extra serverlimiet. Laat deze naam WEG om de regiekeuze te gebruiken.
# MAIL_MODE=disabled
MAIL_ALLOWED_RECIPIENTS=
# Alleen voor de bestaande DG-gateway als bewuste alternatieve mailroute:
SEND_EMAIL_HOOK_SECRET=
MAIL_ORGANIZATION_EMAIL=
MAIL_FROM=
# Optionele HTTPS-basis voor publieke maillogo's/assets; standaard de app-origin.
MAIL_ASSET_BASE_URL=

# OpenAI, LiveKit en Resend worden versleuteld met VLAMPIE_SETTINGS_KEY opgeslagen.
# De app geeft opgeslagen sleutels niet terug aan de browser.
# Google client-ID/secret horen in de eigen Supabase Google-provider.
# Supabase Auth-SMTP staat los van de Resend-beheerkaart voor showmail.
# Zie docs/PROJECTGEGEVENS-EN-SECRETS.md voor de volledige inventaris.
