# Lokaal: kopieer naar .env.local. pnpm dev schakelt de lokale repetitielogin
# expliciet in; die werkt uitsluitend in development op loopback, zonder proxy
# of remote Supabase/databaseconfiguratie. Geen accounts nodig voor ?demo=1.
APP_URL=http://127.0.0.1:4173
MILO_LOCAL_AUTH=false
SQLITE_PATH=.data/milobingo.sqlite
OBJECT_STORAGE_PATH=.data/objects

# Supabase: per omgeving invullen voor echte Auth + PostgreSQL.
# Laat leeg voor lokaal/offline. Alle waarden worden server-side gelezen.
SUPABASE_URL=
# Publieke CA als base64-PEM voor Supabase PostgreSQL-TLS; geen private key.
SUPABASE_DB_CA_BASE64=
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=

# Optioneel: zet op milo-private om remote private objecten expliciet te kiezen.
# Leeg laten voor lokale opslag; vereist bij activatie URL + secret + DATABASE_URL.
# Nooit de secret key naar de browser doorgeven.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=

# Optioneel voor versleutelde regie-instellingen: 64 willekeurige hextekens.
# Behoud bij data-import de oorspronkelijke sleutel. Geen sleutel meegeleverd.
VLAMPIE_SETTINGS_KEY=

# Optioneel voor echte AI-functies: één centrale serversleutel, geen key per vriend.
# Zonder providerconfiguratie blijven echte providerfuncties ongeconfigureerd.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts

# Optionele niet-geheime release-identiteit; later door de echte wrapper invullen.
RELEASE_SHA=
RELEASE_ID=
CONFIG_VERSION=

# Optioneel: echte LiveKit Cloud-koppeling. Altijd alle drie invullen.
# Als een van deze is gezet, heeft dit contract voorrang op opgeslagen instellingen.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Transactionele bestelmail via de vaste gesigneerde Supabase DG-mailgateway.
# De app bevat geen Resend-sleutel of instelbare provider-URL/afzender.
# disabled bewaart bestellingen en toont niet bevestigde mail als mislukt.
# Staging: allowlist + expliciete testontvangers; productie: allowlist of live.
MAIL_ENVIRONMENT=
MAIL_MODE=disabled
MAIL_ALLOWED_RECIPIENTS=
SEND_EMAIL_HOOK_SECRET=
# Verplicht geldig organisatieadres voor de v70-servicemails; afzender blijft gateway-beheer.
# Deze namen vragen apart beoordeelde wrapperconfiguratie voordat echte mail aan kan.
MAIL_ORGANIZATION_EMAIL=
MAIL_FROM=

# LiveKit kan ook via de aparte beveiligde regie-instellingen worden ingericht.
# Google client-ID/secret horen in de eigen Supabase Google-provider.
# DG-mailgateway/outbox- en deploysecrets volgen uit de nog aan te leveren contracten.
# Zie docs/PROJECTGEGEVENS-EN-SECRETS.md voor de volledige inventaris.
