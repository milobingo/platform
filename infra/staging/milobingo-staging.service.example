# Voorbeeld voor /etc/systemd/system/milobingo-staging.service.
# Nog niet geïnstalleerd. De nodeversie en loopbackpoort 4173 zijn op deze host
# bevestigd. De wrapper maakt per release een root-only extern envbestand;
# current/.runtime.env koppelt app en configuratie bij activatie en rollback.
[Unit]
Description=Milo & Friends BingoShow staging
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/srv/sites/milobingo-staging/shared
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=app-mil-stg
Group=app-mil-stg
WorkingDirectory=/srv/sites/milobingo-staging/current/.next/standalone
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_TELEMETRY_DISABLED=1
EnvironmentFile=/srv/sites/milobingo-staging/current/.runtime.env
ExecStart=/opt/node-v24.18.0-linux-x64/bin/node /srv/sites/milobingo-staging/current/.next/standalone/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/sites/milobingo-staging/shared
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal
SyslogIdentifier=milobingo-staging

[Install]
WantedBy=multi-user.target
