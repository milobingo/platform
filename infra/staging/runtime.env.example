# Alleen een namen-/formaatvoorbeeld, geen live configuratie of secretbestand.
# Het voorbeeld kan niet ongewijzigd worden geactiveerd: verplichte velden zijn
# leeg of bevatten __...__-placeholders. Provision via het beoordeelde DG-pad.
# Voorgesteld systeempad: /etc/dg-sites/milobingo-staging.runtime.env, root 0600.
# Dit bestand mag niet in de buildomgeving of een release worden gekopieerd.
APP_URL=https://milo-staging.dgwebservices.nl
MILO_LOCAL_AUTH=false
PORT=__MILO_STAGING_PORT__

SUPABASE_URL=https://lfsdgxcpdyghidzkzzvn.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Beperkte runtime-login; de migratieverbinding blijft buiten dit bestand.
DATABASE_URL=
SUPABASE_STORAGE_BUCKET=milo-staging
SUPABASE_SECRET_KEY=
VLAMPIE_SETTINGS_KEY=

# Alleen voor werkelijk aangesloten providers; incomplete LiveKitsets weigeren.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-sol
OPENAI_SPEECH_MODEL=gpt-live-1
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Door de normale releaseprocedure vast te leggen, zonder secretwaarden.
RELEASE_SHA=__EXACT_FULL_RELEASE_SHA__
RELEASE_ID=__RELEASE_ID__
CONFIG_VERSION=__REVIEWED_CONFIG_VERSION__

# Geen migratie-/backupdatabase, herstelcredentials, GitHub-token, deploysecret,
# LD_*-waarde, NODE_OPTIONS of extra door te voeren runtimekeys toevoegen.
