# Alleen dit Milo-sitefragment integreren via de bestaande Caddystructuur.
# Nog niet geïnstalleerd. Poort 4173 is voor Milo gereserveerd; valideer de gehele
# actieve Caddyconfiguratie. Verander geen andere hosts of globale TLS-instelling.
milo-staging.dgwebservices.nl {
    encode zstd gzip

    reverse_proxy 127.0.0.1:4173 {
        header_up -oai-authenticated-user-id
        header_up -oai-authenticated-user-email
        header_up -x-milo-user
        header_up -x-milo-role
    }
}
