  "scripts": {
    "dev": "node scripts/prepare-next.mjs && MILO_LOCAL_AUTH=true WATCHPACK_POLLING=true next dev --webpack --hostname 127.0.0.1 --port ${PORT:-4173}",
    "build": "node scripts/prepare-next.mjs && next build --webpack && node scripts/package-standalone.mjs",
    "start": "next start --hostname 127.0.0.1 --port ${PORT:-4173}",
    "start:standalone": "HOSTNAME=127.0.0.1 PORT=${PORT:-4173} node .next/standalone/server.js",
    "lint": "eslint app components server/node-*.js tests scripts/check-config.mjs scripts/prepare-next.mjs scripts/package-standalone.mjs scripts/start-standalone-test.mjs scripts/deploy scripts/run-checks.mjs playwright.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-checks.mjs",
    "test:browser": "playwright test",
    "check:config": "node scripts/check-config.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.1.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
